# Demo uses local synthetic fixtures; use OIDC and PostgreSQL for deployed environments.
COPILOT_AUTH_MODE=demo
COPILOT_JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
# For external OAuth2/OIDC RS256 tokens:
# COPILOT_AUTH_MODE=oidc
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Optional PostgreSQL analytics and persistent audit
COPILOT_ANALYTICS_BACKEND=sqlite
COPILOT_AUDIT_BACKEND=sqlite
COPILOT_AUDIT_DB_PATH=copilot_audit.db
DATABASE_URL=postgresql://copilot:local-demo-only@localhost:5432/copilot
# Embedding RAG (install requirements-rag.txt)
COPILOT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
COPILOT_MIN_SIMILARITY=0.25
OPENAI_API_KEY=
COPILOT_LLM_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
