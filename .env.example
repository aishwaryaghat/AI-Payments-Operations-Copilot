# Set a unique random secret; never commit your real values.
COPILOT_JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
# Optional embedding-based RAG (pip install -r requirements-rag.txt)
COPILOT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
COPILOT_MIN_SIMILARITY=0.25
# Optional LLM generation (costs may apply)
OPENAI_API_KEY=
COPILOT_LLM_MODEL=gpt-4o-mini
# Optional compatible provider endpoint
OPENAI_BASE_URL=
